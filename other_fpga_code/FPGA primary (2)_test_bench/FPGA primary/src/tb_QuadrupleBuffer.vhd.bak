library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity tb_QuadrupleBuffer is
end entity;

architecture sim of tb_QuadrupleBuffer is

    component QuadrupleBuffer is
        port (
            CLK           : in  std_logic;
            MISC_B        : in  std_logic;
            SHIFT_CLOCK_1 : out std_logic;
            SHIFT_CLOCK_2 : out std_logic;
            LATCH_CLOCK_1 : out std_logic;
            LATCH_CLOCK_2 : out std_logic;
            MISC_E        : out std_logic;
            MISC_D        : out std_logic;
            DATA          : out std_logic_vector(31 downto 0);
            LED           : out std_logic_vector(3 downto 0)
        );
    end component;

    signal CLK           : std_logic := '0';
    signal MISC_B        : std_logic := '1';  -- UART idle is high
    signal SHIFT_CLOCK_1 : std_logic;
    signal SHIFT_CLOCK_2 : std_logic;
    signal LATCH_CLOCK_1 : std_logic;
    signal LATCH_CLOCK_2 : std_logic;
    signal MISC_E        : std_logic;
    signal MISC_D        : std_logic;
    signal DATA          : std_logic_vector(31 downto 0);
    signal LED           : std_logic_vector(3 downto 0);

    constant CLK_PERIOD : time := 20 ns;  -- 50 MHz
    constant BAUD_RATE  : integer := 203400;
    constant BIT_PERIOD : time := 4916 ns;  -- 1 / 203400 ≈ 4.916 us

    procedure uart_send_byte(
        signal tx : out std_logic;
        constant b : in std_logic_vector(7 downto 0)
    ) is
    begin
        -- idle
        tx <= '1';
        wait for BIT_PERIOD;

        -- start bit
        tx <= '0';
        wait for BIT_PERIOD;

        -- data bits, LSB first
        for i in 0 to 7 loop
            tx <= b(i);
            wait for BIT_PERIOD;
        end loop;

        -- stop bit
        tx <= '1';
        wait for BIT_PERIOD;
    end procedure;

begin

    dut : QuadrupleBuffer
        port map (
            CLK           => CLK,
            MISC_B        => MISC_B,
            SHIFT_CLOCK_1 => SHIFT_CLOCK_1,
            SHIFT_CLOCK_2 => SHIFT_CLOCK_2,
            LATCH_CLOCK_1 => LATCH_CLOCK_1,
            LATCH_CLOCK_2 => LATCH_CLOCK_2,
            MISC_E        => MISC_E,
            MISC_D        => MISC_D,
            DATA          => DATA,
            LED           => LED
        );

    -- 50 MHz clock
    clk_process : process
    begin
        while true loop
            CLK <= '0';
            wait for CLK_PERIOD / 2;
            CLK <= '1';
            wait for CLK_PERIOD / 2;
        end loop;
    end process;

    stim_proc : process
    begin
        -- UART idle
        MISC_B <= '1';

        -- wait some time for DUT to settle
        wait for 100 us;

        -- Command: Start receiving phases = 1111_1110 = x"FE"
        uart_send_byte(MISC_B, x"FE");

        -- Channel 0 phase = 16 = x"10"
        uart_send_byte(MISC_B, x"10");

        -- Channel 1 ~ 255 phase = 0 = x"00"
        for i in 1 to 255 loop
            uart_send_byte(MISC_B, x"00");
        end loop;

        -- Command: Swap buffer = 1111_1101 = x"FD"
        uart_send_byte(MISC_B, x"FD");

        -- wait long enough to observe output update
        wait for 2 ms;

        assert false report "Simulation finished." severity failure;
    end process;

end architecture;