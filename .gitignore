# ============================================================
# IPP workspace recovery repo
# Everything that can be regenerated by recompiling / re-running
# tools is excluded. Source, docs, figures, images, HTML, data,
# reports, PDFs, videos, ZIP archives and all nested repo working
# trees ARE tracked.
# ============================================================

# --- Local tool / editor settings (per-machine) ---
.claude/settings.local.json
.vscode/settings.local.json

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/

# --- External review checkouts (not part of the snapshot) ---
sound_wave_sim_figures/devin/

# --- Quartus / ModelSim / Questa build output (regenerable) ---
db/
incremental_db/
work/
sim_work/
**/output_files/*
!**/output_files/*.sof

*.qpg
*.qtl
*.qdb
*.cdb
*.hdb
*.ddb
*.tdb
*.hsd
*.rcfdb
*.xrf
*.rpt
*.summary
*.smsg
*.done
*.pin
*.sdo
*.vho
*.jic
*.qws
*.wlf
*.vcd
